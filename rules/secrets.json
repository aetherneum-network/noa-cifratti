{
  "file": "secrets",
  "version": "2.0.0",
  "as_of": "2026-09-30",
  "policy": "Ordered: on every line the rules are tried top to bottom and the first rule that claims a span wins; a later rule cannot report an overlapping span. Exceptions (action=ignore) sit on top. action=report blocks, action=suspect asks for review. A rule reports a fingerprint of the named group 'secret', never its text.",
  "limits": {
    "max_file_bytes": 1048576,
    "max_line_chars": 65536,
    "max_block_lines": 80
  },
  "rules": [
    {
      "id": "X-DATA-URI",
      "action": "ignore",
      "kind": "line",
      "pattern": "data:[a-z]+/[a-z0-9.+-]+;base64,(?P<secret>[A-Za-z0-9+/=]+)",
      "reason": "embedded media is not a credential",
      "tests": {
        "ignore": [
          "{{data_uri}}"
        ]
      }
    },
    {
      "id": "X-PUBLIC-ID",
      "action": "ignore",
      "kind": "line",
      "pattern": "(?<![A-Za-z0-9_])(?P<secret>nbxsyn_pub_[a-z2-7]{24})(?![A-Za-z0-9_])",
      "reason": "publishable identifier of the invented vendor: public by design",
      "tests": {
        "ignore": [
          "NBX_PUBLISHABLE_ID = \"{{public_id}}\""
        ]
      }
    },
    {
      "id": "X-URI-REFERENCE",
      "action": "ignore",
      "kind": "line",
      "pattern": "\\b[a-z][a-z0-9+.-]{1,20}://[^\\s:/@\\\"'<>]{1,64}:(?P<secret>\\$\\{[^}\\s]*\\}|\\$[A-Za-z_][A-Za-z0-9_]*|<[^>\\s]*>|\\{\\{[^}]*\\}\\}|%\\([a-z_]+\\)s|change[_-]?me|replace[_-]?me|placeholder|redacted|example|dummy|todo|x{4,}|\\*{4,}|null|none|true|false)@",
      "reason": "the password slot of the URI holds a reference or a placeholder, not a value",
      "tests": {
        "ignore": [
          "DATABASE_URL=nbxdb://app_rw:${DB_PASSWORD}@db.corp.example:5432/app"
        ]
      }
    },
    {
      "id": "X-PLACEHOLDER-VALUE",
      "action": "ignore",
      "kind": "line",
      "flags": "i",
      "pattern": "(?:password|passwd|pwd|secret|token|api[_-]?key|private[_-]?key)[A-Za-z0-9_.-]*[\\\"']?\\s*[:=]\\s*[\\\"']?(?P<secret>\\$\\{[^}\\s]*\\}|\\$[A-Za-z_][A-Za-z0-9_]*|<[^>\\s]*>|\\{\\{[^}]*\\}\\}|%\\([a-z_]+\\)s|change[_-]?me|replace[_-]?me|placeholder|redacted|example|dummy|todo|x{4,}|\\*{4,}|null|none|true|false)[\\\"']?\\s*(?:#.*)?$",
      "reason": "the whole value is a placeholder or a variable reference",
      "tests": {
        "ignore": [
          "DB_PASSWORD=changeme",
          "NBX_API_TOKEN=${NBX_API_TOKEN}",
          "SESSION_SECRET=<your-value-here>",
          "api_key: \"REPLACE_ME\""
        ]
      }
    },
    {
      "id": "X-NONSECRET-KEY",
      "action": "ignore",
      "kind": "line",
      "flags": "i",
      "pattern": "(?:password|passwd|pwd|secret|token|api[_-]?key|private[_-]?key)[A-Za-z0-9.]*?[_-](?:hash|file|path|length|len|min|max|ttl|expiry|header|name|id|field|type|policy|url)(?:[_-][A-Za-z0-9]+)?[\\\"']?\\s*[:=]\\s*[\\\"']?(?P<secret>[^\\s\\\"'#]+)",
      "reason": "the key names a property of a secret (its hash, length, lifetime, header...), not the secret",
      "tests": {
        "ignore": [
          "PASSWORD_MIN_LENGTH=12",
          "TOKEN_TTL=3600",
          "PASSWORD_HASH={{sha256}}",
          "API_KEY_HEADER=X-Api-Key-Name",
          "TOKEN_TYPE = \"bearer_token\""
        ]
      }
    },
    {
      "id": "SEC-ARMORED-BLOCK",
      "action": "report",
      "kind": "block",
      "class": "armored_key_block",
      "begin": "-----BEGIN [A-Z0-9 ]{0,40}(?:KEYBLOCK|PRIVATE KEY)-----",
      "end": "-----END [A-Z0-9 ]{0,40}(?:KEYBLOCK|PRIVATE KEY)-----",
      "tests": {
        "match": [
          "{{block}}"
        ]
      }
    },
    {
      "id": "SEC-NBX-TOKEN",
      "action": "report",
      "kind": "line",
      "class": "vendor_api_token",
      "pattern": "(?<![A-Za-z0-9_])(?P<secret>nbxsyn_tk_[a-z2-7]{32})(?![A-Za-z0-9_])",
      "tests": {
        "match": [
          "NBX_API_TOKEN={{vendor_api_token}}",
          "curl -H \"X-Nbx-Token: {{vendor_api_token}}\" https://api.nimbux.example/v1"
        ]
      }
    },
    {
      "id": "SEC-NBX-TESTKEY",
      "action": "report",
      "kind": "line",
      "class": "vendor_test_key",
      "pattern": "(?<![A-Za-z0-9_])(?P<secret>nbxsyn_test_[a-z2-7]{24})(?![A-Za-z0-9_])",
      "tests": {
        "match": [
          "TEST_KEY = \"{{vendor_test_key}}\""
        ]
      }
    },
    {
      "id": "SEC-QP-KEY",
      "action": "report",
      "kind": "line",
      "class": "vendor_payment_key",
      "pattern": "(?<![A-Za-z0-9-])(?P<secret>QPSYN(?:-[A-Z0-9]{6}){4})(?![A-Za-z0-9-])",
      "tests": {
        "match": [
          "  quillpayKey: {{vendor_payment_key}}"
        ]
      }
    },
    {
      "id": "SEC-HVN-SECRET",
      "action": "report",
      "kind": "line",
      "class": "vendor_webhook_secret",
      "pattern": "(?<![A-Za-z0-9_])(?P<secret>hvnsyn_[A-Za-z0-9]{36})(?![A-Za-z0-9_])",
      "tests": {
        "match": [
          "SIGNING = \"{{vendor_webhook_secret}}\""
        ]
      }
    },
    {
      "id": "SEC-CONN-URI",
      "action": "report",
      "kind": "line",
      "class": "connection_uri_password",
      "pattern": "\\b[a-z][a-z0-9+.-]{1,20}://[^\\s:/@\\\"'<>]{1,64}:(?P<secret>[^\\s@/\\\"'<>]{6,128})@[A-Za-z0-9.-]+",
      "tests": {
        "match": [
          "DATABASE_URL={{uri}}",
          "DSN = \"{{uri}}\""
        ]
      }
    },
    {
      "id": "SUS-WORDLIKE-QUOTED",
      "action": "suspect",
      "kind": "line",
      "class": "wordlike_value_under_secret_key",
      "flags": "i",
      "pattern": "(?:password|passwd|pwd|secret|token|api[_-]?key|private[_-]?key)[A-Za-z0-9_.-]*[\\\"']?\\s*[:=]\\s*(?P<q>[\\\"'])(?=[^\\\"']{8,128}(?P=q))(?P<secret>(?-i:[a-z]+(?:[-_. ][a-z0-9]+)*))(?P=q)",
      "reason": "lowercase words joined by - _ . under a secret-looking key: more likely a label than a generated credential, but a weak password looks the same. A person has to look; the scanner neither blocks nor clears.",
      "tests": {
        "match": [
          "SECRET_QUESTION = \"first-pet-name\"",
          "  adminPassword: \"summer-holiday-2026\""
        ],
        "no_match": [
          "note = \"first-pet-name\""
        ]
      }
    },
    {
      "id": "SUS-WORDLIKE-BARE",
      "action": "suspect",
      "kind": "line",
      "class": "wordlike_value_under_secret_key",
      "flags": "i",
      "path_globs": [
        ".env",
        ".env.*",
        "*/.env",
        "*/.env.*",
        "*.env",
        "*.yml",
        "*.yaml",
        "*.ini",
        "*.cfg",
        "*.conf",
        "*.properties",
        "*.toml",
        "*.sh",
        "*.tfvars"
      ],
      "pattern": "^\\s*(?:export\\s+|-\\s+)?[\\\"']?[A-Za-z0-9_.-]*(?:password|passwd|pwd|secret|token|api[_-]?key|private[_-]?key)[A-Za-z0-9_.-]*[\\\"']?\\s*[:=]\\s*(?=[^\\s\\\"'#]{8,128}\\s*(?:#.*)?$)(?P<secret>(?-i:[a-z]+(?:[-_.][a-z0-9]+)*))\\s*(?:#.*)?$",
      "reason": "same as SUS-WORDLIKE-QUOTED, for unquoted KEY=value lines in environment-like files",
      "tests": {
        "path": "deploy/prod.env",
        "match": [
          "SESSION_SECRET_ROTATION=monthly-2026",
          "DB_PASSWORD=correct-horse-battery"
        ],
        "no_match": [
          "LOG_LEVEL=warn-only-please"
        ]
      }
    },
    {
      "id": "SEC-ASSIGN-QUOTED",
      "action": "report",
      "kind": "line",
      "class": "assigned_password",
      "flags": "i",
      "pattern": "(?:password|passwd|pwd|secret|token|api[_-]?key|private[_-]?key)[A-Za-z0-9_.-]*[\\\"']?\\s*[:=]\\s*(?P<q>[\\\"'])(?P<secret>[^\\\"'\\s]{8,128})(?P=q)",
      "tests": {
        "match": [
          "ADMIN_PASSWORD = \"{{assigned_password}}\"",
          "  \"ldapBindPassword\": \"{{assigned_password}}\",",
          "  adminPassword: \"{{assigned_password}}\""
        ],
        "no_match": [
          "DB_PASSWORD = os.environ[\"DB_PASSWORD\"]",
          "password = prompt(\"Password: \")"
        ]
      }
    },
    {
      "id": "SEC-ASSIGN-BARE",
      "action": "report",
      "kind": "line",
      "class": "assigned_password",
      "flags": "i",
      "path_globs": [
        ".env",
        ".env.*",
        "*/.env",
        "*/.env.*",
        "*.env",
        "*.yml",
        "*.yaml",
        "*.ini",
        "*.cfg",
        "*.conf",
        "*.properties",
        "*.toml",
        "*.sh",
        "*.tfvars"
      ],
      "pattern": "^\\s*(?:export\\s+|-\\s+)?[\\\"']?[A-Za-z0-9_.-]*(?:password|passwd|pwd|secret|token|api[_-]?key|private[_-]?key)[A-Za-z0-9_.-]*[\\\"']?\\s*[:=]\\s*(?P<secret>[^\\s\\\"'#]{8,128})\\s*(?:#.*)?$",
      "tests": {
        "path": "deploy/prod.env",
        "match": [
          "DB_PASSWORD={{assigned_password}}",
          "export BACKUP_PASSWORD={{assigned_password}}",
          "  smtp_password: {{assigned_password}}"
        ],
        "no_match": [
          "LOG_LEVEL=warn",
          "PASSWORD=short"
        ]
      }
    },
    {
      "id": "SUS-BASE64",
      "action": "suspect",
      "kind": "decode",
      "encoding": "base64",
      "class": "encoded_secret",
      "pattern": "(?<![A-Za-z0-9+/])(?P<secret>[A-Za-z0-9+/]{24,}={0,2})(?![A-Za-z0-9+/=])",
      "tests": {
        "match": [
          "CACHE_SEED={{b64:vendor_api_token}}"
        ],
        "no_match": [
          "Encoded banner: V2VsY29tZSB0byB0aGUgc3RhZ2luZyBlbnZpcm9ubWVudA=="
        ]
      }
    },
    {
      "id": "SUS-HEX",
      "action": "suspect",
      "kind": "decode",
      "encoding": "hex",
      "class": "encoded_secret",
      "pattern": "(?<![0-9A-Fa-f])(?P<secret>(?:[0-9A-Fa-f]{2}){16,})(?![0-9A-Fa-f])",
      "tests": {
        "match": [
          "CACHE_SALT={{hex:vendor_api_token}}"
        ],
        "no_match": [
          "--hash=sha256:{{sha256}}"
        ]
      }
    },
    {
      "id": "SUS-PERCENT",
      "action": "suspect",
      "kind": "decode",
      "encoding": "percent",
      "class": "encoded_secret",
      "pattern": "(?P<secret>(?:%[0-9A-Fa-f]{2}){8,})",
      "tests": {
        "match": [
          "Callback: https://hooks.corp.example/in?k={{pct:vendor_api_token}}"
        ],
        "no_match": [
          "https://docs.corp.example/a%20b%20c%20d%20e%20f%20g%20h%20i"
        ]
      }
    },
    {
      "id": "SUS-REVERSED",
      "action": "suspect",
      "kind": "decode",
      "encoding": "reversed",
      "class": "encoded_secret",
      "pattern": "(?<![^\\s\\\"'=:,;(\\[])(?P<secret>[^\\s\\\"'=,;()\\[\\]]{20,512})(?![^\\s\\\"',;)\\]])",
      "tests": {
        "match": [
          "PAYLOAD_7={{rev:vendor_api_token}}"
        ],
        "no_match": [
          "PAYLOAD_7=0123456789abcdefghijklmnop"
        ]
      }
    },
    {
      "id": "SUS-CONCAT",
      "action": "suspect",
      "kind": "concat",
      "class": "concatenated_secret",
      "pattern": "(?P<secret>(?:\\\"[^\\\"\\\\]*\\\"|'[^'\\\\]*')(?:\\s*\\+\\s*(?:\\\"[^\\\"\\\\]*\\\"|'[^'\\\\]*'))+)",
      "tests": {
        "match": [
          "JOINED = \"{{half1:vendor_api_token}}\" + \"{{half2:vendor_api_token}}\""
        ],
        "no_match": [
          "name = \"app\" + \"-\" + \"v2\""
        ]
      }
    }
  ]
}
